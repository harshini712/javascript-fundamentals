// Example 1: Find the Maximum of Two Numbers

function findMax(a, b) {
    if (a > b) {
        return a;
    } else {
        return b;
    }
}

console.log(findMax(10, 20));
console.log(findMax(35, 15));


//Example 2: Check Even or Odd
function isEven(num) {
    return num % 2 === 0;
}

console.log(isEven(8));  
console.log(isEven(15));  