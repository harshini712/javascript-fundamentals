//number of vowels

let str = "Beautiful";
let count=0;

function countVowels(str){
    str = str.toLowerCase();
    for (i in str){
        let char = str [i];
        if (char === "a"|| char === "e"||char ==="i"|| char === "o"|| char === "u"){
            count++
        }
        
    }
}
countVowels(str);
console.log(count)

