function addStudent(){
    let name = prompt("Enter Student's name: ");
    arr.push(name);
    console.log("Student's name added successfully!");
}


function viewStudents(){
    let i=0;
    while(i<arr.length){
        console.log(i+1,".",arr[i])
        i++
    }
}

function searchStudent(){
    let name = (prompt("Enter the student's name: "))
    let i=0;
    let found = false;
    while (i<arr.length){
        if (arr[i].toLowerCase()===name.toLowerCase()){
            console.log("student found.")
            found = true;
            break;
        }
        i++
    }if (!found){
        console.log("Student not found");
    }
}

function updateStudent(){
    let name=(prompt("Enter the current student name: "))
    let newName = (prompt("Enter the new name: "))
    let found = false;
    let i=0;
    while(i<arr.length){
        if (arr[i].toLowerCase() === name.toLowerCase()) {
            arr[i] = newName;
            found = true;
            console.log("Student updated successfully");
            break;
        } 
        i++
    }

    if (!found) {
        console.log("Student not found");
    }
}

function deleteStudent(){
    let name = prompt("Enter the student's name to delete: ");
    let i=0;
    let found = false;
    
    while (i<arr.length){
    if (arr[i].toLowerCase() === name.toLowerCase()){
        arr.splice(i,1);
            console.log("Student deleted successfully!");
            viewStudents();
            found = true;
            break;
    }i++;
    }
}
    
function sortStudent() {

    arr.sort();

    console.log("Students sorted:");
