}

function topScorer() {

    let marks = [85, 92, 78, 95, 88, 90, 80, 87];

    let highest = marks[0];
    let index = 0;

    for (let i = 1; i < marks.length; i++) {

        if (marks[i] > highest) {
            highest = marks[i];
            index = i;
        }
    }

    console.log("Top Scorer:", arr[index]);
    console.log("Marks:", highest);
}

function searchStudentByGrade() {

    let grade = prompt("Enter grade:");

    let grades = ["A", "B", "A+", "A+", "B+", "A", "B", "A"];

    let found = false;

    for (let i = 0; i < grades.length; i++) {

        if (grades[i].toLowerCase() === grade.toLowerCase()) {

            console.log(arr[i], "-", grades[i]);
            found = true;
        }
    }

    if (!found) {
        console.log("No students found with this grade");
    }
}