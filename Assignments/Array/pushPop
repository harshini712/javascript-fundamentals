//even odd 
let arr7 = [1, 2, 3, 4, 5, 6, 7, 8];
let even = [];
let odd = [];

for (let i=0; i<arr7.length; i++){
    if (arr7[i]%2===0){
        even.push(arr7[i])
    }else{
        odd.push(arr7[i])
    }
}
console.log(even)
console.log(odd)



//sort

let arr = [5, 2, 1, 3, 7, 4, 9];

for (let i = 0; i < arr.length; i++) {
    let smallest = i;

    for (let j = i + 1; j < arr.length; j++) {
        if (arr[j] < arr[smallest]) {
            smallest = j;
        }
    }

    let temp = arr[i];
    arr[i] = arr[smallest];
    arr[smallest] = temp;
}

console.log(arr);