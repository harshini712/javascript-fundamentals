let arr = [5,2,1,3,7,4,9];
let sorted = [];
let smallest = arr[0];
for (i in arr){
    if (smallest < arr[i]){
        sorted.push()
    }else{
        sorted.push(smallest)
    }
}

console.log(sorted)

//sort

let arr = [5, 2, 1, 3, 7, 4, 9];

for (let i = 0; i < arr.length; i++) {
    let smallest = i;

    for (let j = i + 1; j < arr.length; j++) {
        if (arr[j] < arr[smallest]) {
            smallest = j;
        }
    }

    let temp = arr[i];
    arr[i] = arr[smallest];
    arr[smallest] = temp;
}

console.log(arr);