
//find second largest element
let arr = [64,23,78,46,39];
let largest = arr[0];
let secondLargest = arr[0];

for (i=0; i<arr.length; i++){
    if (arr[i]>largest){
        secondLargest = largest;
        largest =arr[i];
    } else if (arr[i] > secondLargest && arr[i]< largest){
        secondLargest = arr[i];
    }
}
