//merge two arrays and remove duplicates

let arr1 = [1,3,2,5,3];
let arr2 = [1,7,8,5,4];

let arr = arr1.concat(arr2)
let result = [ ]

for (i=0; i<arr.length; i++){
    let count = 0;
    
    for (j=0; j<i; j++){
        if (arr[i]===arr[j]){
            count++
        }
    }
    if (count<1){
        result.push(arr[i])
    }
}
console.log(result)