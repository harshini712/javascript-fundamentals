let str = "malayalam";
let reverse = str.split(" ").reverse("").join("")

if(str = reverse){
    console.log(true,",", str, "is a palindrome")
}else{
    console.log(false,",", str, "is not a palindrome")
}

//reverse each word without changing the sentence order

let str1 = "Drink plenty of water"
let words = str1.split(" ")

let reversed = words.map(word=> word.split("").reverse().join("")).join(" ");
console.log(reversed)


//reverse without using built in method

let arr = [1,2,3,4,5]
let left = 0;
let right = arr.length-1;

while (left<right){
    let temp = arr[left];
    arr[left]=arr[right];
    arr[right]=temp;
    left++
    right--

}
console.log(arr)

//anagram

let str1 = "listen";
let str2 = "silent";

if (
    str1.split("").sort().join("") ===
    str2.split("").sort().join("")
) {
    console.log("Anagram");
} else {
    console.log("Not an Anagram");
}
