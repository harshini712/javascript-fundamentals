let str = "aaabbcccc"
let compressed = ""
let count=1;

for(i=0; i<str.length; i++){
    if (str[i] === str[i+1]){
        count++
    }else{
        compressed=compressed+str[i]+count;
        count=1;
    }
}
console.log(compressed)

