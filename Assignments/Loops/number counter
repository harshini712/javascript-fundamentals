//frequency of 4s

let arr=[2,3,4,1,6,4,3,5,4,7];
let count=0;
for(let i=0; i<=arr.length; i++){
    if (arr[i]=== 4){ 
        count++
    }   else{
        continue;
    }
}
console.log("Number of 4's : ", count);


